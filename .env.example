# ═══════════════════════════════════════════════════════════
# UPI RADAR — Environment Variables
# Copy to .env and fill in values. Everything has safe defaults,
# so the system boots in DEMO MODE even with an empty .env.
# ═══════════════════════════════════════════════════════════

# ── Razorpay (Test Mode - FREE: https://dashboard.razorpay.com) ──
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YYYYYYYYYYYYYYYYYYYY

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=upi_radar
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
DATABASE_URL=postgresql://admin:password123@localhost:5432/upi_radar

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Kafka ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=upi_transactions
KAFKA_TOPIC_ALERTS=upi_alerts

# ── Alert Config ────────────────────────────────────────────
ALERT_EMAIL_FROM=upi.radar@gmail.com
ALERT_EMAIL_TO=sre-team@razorpay.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_PASSWORD=your_app_password

TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=YYYYYYYYYYYYYYYYYY
TWILIO_FROM_NUMBER=+1234567890

# ── Model / Policy Thresholds ───────────────────────────────
OUTAGE_PROBABILITY_THRESHOLD=0.70
BANK_HEALTH_CRITICAL_THRESHOLD=30
BANK_HEALTH_WARNING_THRESHOLD=70
QUEUE_MAX_WAIT_SECONDS=120

# ── System behaviour ────────────────────────────────────────
# DEMO_MODE=true → simulate stream + mock predictions so the full
# system runs end-to-end without Razorpay keys / Kafka / trained models.
DEMO_MODE=true
PREDICTION_INTERVAL_SECONDS=300
QUEUE_PROCESS_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
